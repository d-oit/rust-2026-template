[
  {
    "id": "excalidraw-generation",
    "prompt": "Generate the architecture diagram in Excalidraw format",
    "command": "python .agents/skills/architecture-diagram/scripts/generate_diagram.py --root . --no-export --out .template/architecture.excalidraw",
    "expected_output": "Excalidraw JSON file written to .template/architecture.excalidraw with valid schema",
    "assertions": [
      {
        "type": "file_exists",
        "path": ".template/architecture.excalidraw"
