      {
        "type": "content_contains",
        "path": ".template/architecture.excalidraw",
        "value": "\"type\": \"excalidraw\""
      },
      {
        "type": "content_contains",
        "path": ".template/architecture.excalidraw",
        "value": "\"version\": 2"
      },
