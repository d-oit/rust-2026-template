{
  "env_var_name": "XTASK_TIER",
  "default_tier": "protected-branch",
  "tiers": {
    "pull-request": {
      "checks": [
        "LocLimits",
        "Fmt",
        "Clippy",
        "Build",
        "Test",
        "DocTest",
        "Doc",
        "Audit",
        "Deny",
        "Msrv",
        "ShellCheck",
        "MarkdownLint",
        "YamlLint",
        "SkillValidation",
        "SkillEvals",
        "PrivacyCheck",
        "SecretScan",
        "WorkflowValidation",
        "ActionLint"
      ],
      "required_checks": [
        "Audit",
        "Deny",
        "Msrv",
        "ShellCheck",
        "MarkdownLint",
        "YamlLint",
        "WorkflowValidation",
        "ActionLint",
        "SecretScan"
      ]
    },
    "protected-branch": {
      "checks": [
        "LocLimits",
        "Fmt",
        "Clippy",
        "Build",
        "Test",
        "DocTest",
        "Doc",
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "ShellCheck",
        "MarkdownLint",
        "YamlLint",
        "SkillValidation",
        "SkillEvals",
        "PrivacyCheck",
        "SecretScan",
        "WorkflowValidation",
        "ActionLint"
      ],
      "required_checks": [
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "ShellCheck",
        "MarkdownLint",
        "YamlLint",
        "WorkflowValidation",
        "ActionLint",
        "SecretScan",
        "Doc"
      ]
    },
    "scheduled": {
      "checks": [
        "SkillValidation",
        "AdrCompliance",
        "SkillEvals",
        "LlmContext",
        "Clippy",
        "Test",
        "Audit",
        "Deny",
        "Machete",
        "Msrv"
      ]
    },
    "release": {
      "checks": [
        "Clippy",
        "Build",
        "Test",
        "DocTest",
        "Doc",
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "WorkflowValidation",
        "ActionLint",
        "YamlLint",
        "PrivacyCheck",
        "SecretScan"
      ],
      "required_checks": [
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "WorkflowValidation",
        "ActionLint",
        "YamlLint",
        "SecretScan",
        "Doc"
      ]
    }
  },
  "when_changed": {
    "Fmt": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml"
    ],
    "Clippy": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml"
    ],
    "Build": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml"
    ],
    "Test": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml"
    ],
    "DocTest": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml"
    ],
    "Audit": [
      "**/Cargo.toml",
      "**/Cargo.lock",
      "deny.toml",
      ".cargo/audit.toml"
    ],
    "Deny": [
      "**/Cargo.toml",
      "**/Cargo.lock",
      "deny.toml"
    ],
    "Machete": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock"
    ],
    "Msrv": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml",
      "scripts/audit-msrv.sh"
    ],
    "ShellCheck": [
      "scripts/**/*.sh",
      "**/*.sh"
    ],
    "MarkdownLint": [
      "**/*.md"
    ],
    "YamlLint": [
      "**/*.yml",
      "**/*.yaml"
    ],
    "WorkflowValidation": [
      ".github/workflows/*.yml",
      "config/trusted-publishing.json",
      "scripts/trustpub.py",
      "scripts/trustpub.sh",
      "scripts/validate-workflows.sh",
      "tests/trusted_publishing_contract_test.sh",
      "tests/trustpub_cli_test.sh"
    ],
    "ActionLint": [
      ".github/workflows/*.yml",
      ".github/actions/**"
    ],
    "SkillValidation": [
      ".agents/skills/**",
      ".agents/SKILLS.md",
      "scripts/validate-skills.sh",
      ".claude/skills",
      ".qwen/skills"
    ],
    "SkillEvals": [
      ".agents/skills/**",
      "scripts/run-evals.sh"
    ],
    "Doc": [
      "**/*.rs",
      "**/Cargo.toml",
      "**/Cargo.lock",
      "rust-toolchain.toml"
    ]
  },
  "lint_thresholds": {
    "max_lines_per_file": 500,
    "clippy_warnings_as_errors": true
  }
}
