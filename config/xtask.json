{
  "env_var_name": "XTASK_TIER",
  "default_tier": "protected-branch",
  "tiers": {
    "pull-request": {
      "checks": [
        "LocLimits",
        "Fmt",
        "Clippy",
        "Build",
        "Test",
        "DocTest",
        "SkillValidation",
        "SkillEvals",
        "PrivacyCheck",
        "SecretScan",
        "WorkflowValidation",
        "ActionLint"
      ]
    },
    "protected-branch": {
      "checks": [
        "LocLimits",
        "Fmt",
        "Clippy",
        "Build",
        "Test",
        "DocTest",
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "ShellCheck",
        "MarkdownLint",
        "YamlLint",
        "SkillValidation",
        "SkillEvals",
        "PrivacyCheck",
        "SecretScan",
        "WorkflowValidation",
        "ActionLint",
        "CiStatusArtifact"
      ],
      "required_checks": [
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "ShellCheck",
        "MarkdownLint",
        "YamlLint",
        "WorkflowValidation",
        "ActionLint",
        "SecretScan"
      ]
    },
    "scheduled": {
      "checks": [
        "SkillValidation",
        "AdrCompliance",
        "SkillEvals",
        "RoastScorer",
        "LlmContext",
        "Clippy",
        "Test",
        "Audit",
        "Deny",
        "Machete",
        "Msrv"
      ]
    },
    "release": {
      "checks": [
        "Clippy",
        "Build",
        "Test",
        "DocTest",
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "WorkflowValidation",
        "ActionLint",
        "YamlLint",
        "PrivacyCheck",
        "SecretScan"
      ],
      "required_checks": [
        "Audit",
        "Deny",
        "Machete",
        "Msrv",
        "WorkflowValidation",
        "ActionLint",
        "YamlLint",
        "SecretScan"
      ]
    }
  },
  "when_changed": {
    "Fmt": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock", "rust-toolchain.toml"],
    "Clippy": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock", "rust-toolchain.toml"],
    "Build": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock", "rust-toolchain.toml"],
    "Test": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock", "rust-toolchain.toml"],
    "DocTest": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock", "rust-toolchain.toml"],
    "Audit": ["**/Cargo.toml", "**/Cargo.lock", "deny.toml", ".cargo/audit.toml"],
    "Deny": ["**/Cargo.toml", "**/Cargo.lock", "deny.toml"],
    "Machete": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock"],
    "Msrv": ["**/*.rs", "**/Cargo.toml", "**/Cargo.lock", "rust-toolchain.toml", "scripts/audit-msrv.sh"],
    "ShellCheck": ["scripts/**/*.sh", "**/*.sh"],
    "MarkdownLint": ["**/*.md"],
    "YamlLint": ["**/*.yml", "**/*.yaml"],
    "WorkflowValidation": [".github/workflows/*.yml", "scripts/validate-workflows.sh"],
    "ActionLint": [".github/workflows/*.yml", ".github/actions/**"],
    "SkillValidation": [".agents/skills/**", ".agents/SKILLS.md", "scripts/validate-skills.sh", ".claude/skills", ".qwen/skills"],
    "SkillEvals": [".agents/skills/**", "scripts/run-evals.sh"]
  },
  "lint_thresholds": {
    "max_lines_per_file": 500,
    "clippy_warnings_as_errors": true
  }
}
